# ─── Required ────────────────────────────────────────────────────────────────

# Full URL of your ORI node (Railway internal or public)
ORI_NODE_URL=https://nozomi.proxy.rlwy.net:32346

# API token for the ORI node (BTPY_API_TOKEN)
ORI_NODE_TOKEN=your_node_api_token_here

# Pool wallet — generated by: python generate_pool_wallet.py
POOL_ADDRESS=ori1q...
POOL_PRIV_HEX=your_64_char_private_key_hex
POOL_PUB_HEX=your_66_char_compressed_pubkey_hex

# ─── Optional (sensible defaults) ────────────────────────────────────────────

# Pool display name
POOL_NAME=ORI Pool

# Pool fee percentage (default 1%)
POOL_FEE_PCT=1.0

# Starting pool difficulty (auto-adjusted per worker via vardiff)
# Lower = easier shares, higher = more CPU per share
POOL_DIFF=0.01

# PPLNS window: number of shares to consider per block payout
PPLNS_N=1000000

# Minimum payout per worker per block (in satoshis; 100000000 = 1 ORI)
MIN_PAYOUT_SATS=100000000

# ORI coinbase maturity (must match node config)
COINBASE_MATURITY=100

# Vardiff: target seconds per share per worker
VARDIFF_TARGET_SECS=10
VARDIFF_MIN=0.001
VARDIFF_MAX=10000.0

# SQLite database path (use an absolute path for Railway volumes)
POOL_DB_PATH=pool.db

# Railway injects $PORT automatically — do NOT change this
# PORT=3333
